# GEMINI_API_KEY: Required for server-side fish species photo recognition (FR-10).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Free routing (Valhalla/OSRM), geocoding (Photon OSM), and weather (Open-Meteo) work out of the box with no API keys.
# Optional free-tier OpenRouteService key (2,000 req/day) & external provider keys (server-side proxy only)
ORS_API_KEY=""
ACTIGATOR_API_KEY=""
YANDEX_MAPS_API_KEY=""
YANDEX_ROUTING_API_KEY=""
SENTINEL_HUB_TOKEN=""
SESSION_SECRET="change-me-in-production"

# Optional backend origin for standalone Capacitor Android APK builds (leave empty for local/standalone mode)
VITE_API_BASE_URL=""
